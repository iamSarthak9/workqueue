# WorkQueue Configuration Template
# Copy this file to .env and customize for your target deployment

# Redis Connection URL
REDIS_URL=redis://localhost:6379

# Service Ports
PORT_PRODUCER=8080
PORT_WORKER=8081

# Queue & Dead-Letter Queue Names
QUEUE_NAME=workqueue:tasks
DLQ_NAME=workqueue:dlq

# Worker Pool Concurrency (number of parallel worker goroutines)
WORKER_CONCURRENCY=5

# Graceful Shutdown Drain Timeout (seconds)
SHUTDOWN_TIMEOUT_SECONDS=10

# Structured Logging Configuration (DEBUG | INFO | WARN | ERROR)
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/workqueue.log
